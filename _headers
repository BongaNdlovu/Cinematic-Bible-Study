/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/models/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/shelf/covers/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/vendor/supabase/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/vendor/leaflet/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The three build files and the Sentry bundle are content-hashed at deploy
# time (tools/hash-release-assets.mjs), so they can be immutable. The three
# addons under /vendor/three/examples/ are not hashed and stay on /vendor/*.
/vendor/three/build/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/vendor/sentry/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/bible/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
