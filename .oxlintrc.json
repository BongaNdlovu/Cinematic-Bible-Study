{
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "ignorePatterns": [
    "vendor/**",
    "node_modules/**",
    "qa/**",
    "qa-e2e/**",
    "tools/**",
    "models/**",
    "assets/**"
  ],
  "rules": {
    "complexity": ["error", 44],
    "no-underscore-dangle": "off",
    "consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "no-unused-vars": ["error", { "caughtErrors": "none", "args": "none" }],
    "max-lines": ["error", { "max": 800, "skipBlankLines": false, "skipComments": false }],
    "max-lines-per-function": ["error", { "max": 100 }]
  },
  "overrides": [
    {
      "files": [
        "js/content/sheets-data.js",
        "js/features/desk.js",
        "js/pages/gallery/artifact-registry.js",
        "js/pages/gallery/gallery.js",
        "js/pages/index/shelf.js",
        "js/pages/study/book-reader.js",
        "js/pages/study/study-app.js"
      ],
      "rules": { "max-lines": "off" }
    },
    {
      "files": [
        "js/features/progress-sync.js",
        "js/features/reviews.js",
        "js/pages/dashboard/dashboard.js",
        "js/pages/gallery/gallery.js",
        "js/pages/gallery/hall-art.js",
        "js/pages/index/shelf.js",
        "js/pages/map/globe.js",
        "js/pages/map/map-render.js",
        "js/pages/map/map.js",
        "js/pages/study/book-reader.js",
        "js/pages/study/certificate.js",
        "js/pages/study/competency.js",
        "js/pages/study/diagrams/fullscreen.js",
        "js/pages/study/diagrams/timeline.js",
        "js/pages/study/mindmap-render.js",
        "js/pages/study/mindmap.js",
        "js/pages/study/quiz.js",
        "js/pages/study/story.js",
        "js/pages/study/study-app.js",
        "js/pages/study/weather-scene.js",
        "js/pages/study/workbench-sittings.js",
        "js/pages/study/workbench.js"
      ],
      "rules": { "max-lines-per-function": "off" }
    },
    {
      "files": ["js/**/*.js"],
      "env": {
        "browser": true,
        "es2024": true
      },
      "globals": {
        "sheetsData": "readonly",
        "timelineEpochs": "readonly",
        "L": "readonly"
      },
      "rules": {
        "no-undef": "error"
      }
    }
  ]
}
