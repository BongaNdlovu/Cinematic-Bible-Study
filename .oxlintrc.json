{
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "ignorePatterns": [
    "vendor/**",
    "node_modules/**",
    "qa/**",
    "qa-e2e/**",
    "tools/**",
    "models/**",
    "assets/**"
  ],
  "rules": {
    "complexity": ["error", 55],
    "no-underscore-dangle": "off",
    "consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "no-unused-vars": ["error", { "caughtErrors": "none", "args": "none" }]
  },
  "overrides": [
    {
      "files": ["js/**/*.js"],
      "env": {
        "browser": true,
        "es2024": true
      },
      "globals": {
        "sheetsData": "readonly",
        "timelineEpochs": "readonly",
        "L": "readonly"
      },
      "rules": {
        "no-undef": "error"
      }
    }
  ]
}
